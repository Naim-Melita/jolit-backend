# Configuracion del despliegue de la API.
#
#   cp deploy.env.example deploy.env
#
# deploy.env no se versiona, asi que sobrevive a los despliegues. Este archivo
# de ejemplo si, y es solo la referencia.

# Carpeta donde esta clonado el repositorio. Si se deja vacio, se usa la
# carpeta donde esta el propio deploy.sh, que casi siempre es la correcta.
# APP_DIR=/var/www/jolit-backend

# Como se reinicia el proceso. Las dos formas mas comunes:
#   pm2:      pm2 restart jolit-api
#   systemd:  sudo systemctl restart jolit-api
RESTART_CMD="pm2 restart jolit-api"

# Por donde contesta la API dentro del servidor, para verificar el despliegue.
HEALTH_URL="http://127.0.0.1:4000/api/health"

# Si node se instalo con nvm, una sesion SSH no interactiva no lo encuentra.
# Descomentar y poner la version que corresponda:
# export PATH="$HOME/.nvm/versions/node/v22.22.0/bin:$PATH"
