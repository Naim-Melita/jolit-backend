# Configuracion del backend de Jolit.
#
# Copiar a .env y completar. El .env NO se sube a git: lleva claves con las
# que se puede cobrar y leer datos de clientas.
#
# Las lineas marcadas con [PROD] cambian de valor en el servidor.

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
NODE_ENV=development                                    # [PROD] production
PORT=4000

# Interfaz donde escucha. 127.0.0.1 es lo correcto cuando adelante hay un
# nginx o similar haciendo de proxy. Solo poner 0.0.0.0 si el proceso tiene
# que ser alcanzable directo desde afuera.
HOST=127.0.0.1

# Desde que origenes se aceptan pedidos del navegador. Separar con comas.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# [PROD] FRONTEND_ORIGIN=https://jolit.com.ar,https://www.jolit.com.ar

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jolit?schema=public"

# Poner en 1 para ver cada consulta SQL en la consola. Solo para depurar.
PRISMA_LOG_QUERIES=

# ---------------------------------------------------------------------------
# Panel de administracion
# ---------------------------------------------------------------------------
# OJO: estas dos SOLO se usan para crear la cuenta la primera vez, cuando la
# tabla admin_accounts esta vacia. Si la cuenta ya existe, cambiarlas aca no
# hace absolutamente nada: el login se valida contra la base.
#
# Para cambiar la cuenta o la contrasenia:
#   npm run admin:set -- --email=vos@dominio.com
# Sin --password genera una fuerte y la muestra una sola vez.
ADMIN_EMAIL=admin@jolit.local
ADMIN_PASSWORD=admin123

# Alternativa a los flags de admin:set, por si conviene no dejar la
# contrasenia en el historial de la terminal.
ADMIN_SET_EMAIL=
ADMIN_SET_PASSWORD=

# Firma el token de sesion del panel. OBLIGATORIO en produccion, minimo 32
# caracteres. Generar con: openssl rand -hex 32
ADMIN_JWT_SECRET=

# ---------------------------------------------------------------------------
# Clerk (cuentas de las clientas)
# ---------------------------------------------------------------------------
# La clave publica y la secreta tienen que ser de la MISMA instancia, y la
# publica tiene que coincidir con la del frontend.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ADMIN_EMAILS=admin@jolit.local

# Opcional. Sincroniza altas y bajas de cuentas hacia nuestra tabla de
# clientas. Sin esto todo funciona igual: la clienta se crea sola la primera
# vez que entra logueada. Se saca del panel de Clerk, en Webhooks, apuntando
# a  https://api.jolit.com.ar/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=

# IMPORTANTE: el reloj del servidor tiene que estar sincronizado por NTP.
# Clerk firma los tokens con su hora; si el servidor se atrasa mas de 30
# segundos, los rechaza y las clientas quedan logueadas en pantalla pero
# desconocidas para el backend.

# ---------------------------------------------------------------------------
# Mercado Pago
# ---------------------------------------------------------------------------
# De prueba: token de un usuario de prueba vendedor.
# [PROD] credenciales de produccion de la cuenta real (empiezan con APP_USR-).
MP_ACCESS_TOKEN=

# Firma de los avisos de pago. Es de la APLICACION, no de la cuenta: si se
# cambia de aplicacion, este secreto tambien cambia.
MP_WEBHOOK_SECRET=

# URL publica del backend, para que Mercado Pago pueda avisar los pagos.
# Vacia en local: ahi los pagos los levanta la reconciliacion cada 5 minutos.
# [PROD] BACKEND_PUBLIC_URL=https://api.jolit.com.ar
BACKEND_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Sin esto los pedidos se guardan igual, pero no se avisa a nadie.
# Revisar que este funcionando con:  npm run email:check
RESEND_API_KEY=

# El dominio del remitente tiene que estar verificado en Resend. Con el
# remitente de prueba (onboarding@resend.dev) Resend solo entrega a la casilla
# con la que se creo la cuenta: las clientas NO reciben nada.
EMAIL_FROM="Jolit <onboarding@resend.dev>"
# [PROD] EMAIL_FROM="Jolit <pedidos@jolit.com.ar>"

# A donde llega el aviso de "cobraste $X". Tambien es el reply-to de los
# mails a las clientas, asi que si responden, caen aca.
OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Imagenes (Cloudinary)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=jolit/products

# ---------------------------------------------------------------------------
# Envios (Correo Argentino / PAQ.AR)
# ---------------------------------------------------------------------------
# Pedir credenciales comerciales oficiales antes de activar cotizacion real.
# Sin ellas se cotiza con las tarifas planas de abajo.
CORREO_ARGENTINO_API_KEY=
CORREO_ARGENTINO_AGREEMENT=

# Tarifas de respaldo. Lo que se carga en el panel tiene prioridad sobre esto.
CORREO_ARGENTINO_FREE_SHIPPING_MINIMUM=100000
CORREO_ARGENTINO_CABA_RATE=2500
CORREO_ARGENTINO_GBA_RATE=3500
CORREO_ARGENTINO_INTERIOR_RATE=5500

# ---------------------------------------------------------------------------
# Limpieza de pedidos pendientes
# ---------------------------------------------------------------------------
# Horas que se le reserva el stock a un pedido sin pagar antes de liberarlo.
# El segundo aplica a los que tienen un pago iniciado pero sin acreditar,
# como el efectivo en Pago Facil o Rapipago, que puede tardar dias.
PENDING_ORDER_TTL_HOURS=48
PENDING_PAYMENT_TTL_HOURS=168
