NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jolit?schema=public"

# Legacy admin. Mantener mientras el panel admin no use Clerk al 100%.
ADMIN_EMAIL=admin@jolit.local
ADMIN_PASSWORD=admin123

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=jolit/products

# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_ADMIN_EMAILS=admin@jolit.local

# Correo Argentino / PAQ.AR
# Pedir credenciales comerciales oficiales antes de activar cotizacion real.
CORREO_ARGENTINO_API_KEY=
CORREO_ARGENTINO_AGREEMENT=
CORREO_ARGENTINO_FREE_SHIPPING_MINIMUM=100000
CORREO_ARGENTINO_CABA_RATE=2500
CORREO_ARGENTINO_GBA_RATE=3500
CORREO_ARGENTINO_INTERIOR_RATE=5500

# Email (Resend). Sin esto los pedidos se guardan igual, pero no se avisa a nadie.
RESEND_API_KEY=
EMAIL_FROM="Jolit <pedidos@tudominio.com>"
OWNER_EMAIL=

# Secreto para firmar el token del panel admin. Obligatorio en produccion,
# minimo 32 caracteres. Generar con: openssl rand -hex 32
ADMIN_JWT_SECRET=

# Mercado Pago. Se sacan del panel de desarrolladores de MP.
# MP_ACCESS_TOKEN de prueba empieza con TEST-, el de produccion con APP_USR-.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL publica del backend, para que MP pueda avisar los pagos.
# En local se puede usar un tunel (ngrok, cloudflared).
BACKEND_PUBLIC_URL=

# Expiracion de pedidos pendientes (horas). El segundo aplica a los que tienen
# un pago iniciado pero sin acreditar, como el efectivo en Rapipago.
PENDING_ORDER_TTL_HOURS=48
PENDING_PAYMENT_TTL_HOURS=168
