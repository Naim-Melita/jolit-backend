{
  "name": "jolit-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "prebuild": "prisma generate",
    "verify": "npm run check && npm run test && npm run build",
    "admin:set": "tsx src/scripts/set-admin.ts",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "email:check": "tsx src/scripts/check-email.ts",
    "productos:importar": "tsx src/scripts/import-products.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.22",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pdfkit": "^0.17.6",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^3.6.0",
    "multer": "^2.1.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.21.0",
    "svix": "^1.94.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.2",
    "prisma": "^7.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3"
  }
}
